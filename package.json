{
  "name": "period-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Period Mirror — a privacy-first personal menstrual health companion (mobile-first PWA prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && STANDALONE=1 vite build",
    "build:pages": "tsc -b && STANDALONE=1 VITE_HASH_ROUTER=true vite build && node scripts/pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.2"
  }
}
