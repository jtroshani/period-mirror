# Period Mirror — environment configuration
#
# The prototype runs entirely on-device with mocked AI + wearable data and
# needs NO environment variables. These are placeholders for future
# integrations. Never commit real secrets. Only variables prefixed with
# VITE_ are exposed to the client bundle — keep provider secrets on a server.

# --- AI extraction (currently mocked in src/services/ai) ---
# When set, an adapter can route "How do I feel today?" text to a real model.
# Prefer proxying through your own backend so the key is never in the bundle.
VITE_AI_EXTRACTION_ENDPOINT=
VITE_AI_EXTRACTION_ENABLED=false

# --- Wearable / health-platform integrations (currently mocked) ---
VITE_HEALTHKIT_ENABLED=false
VITE_HEALTH_CONNECT_ENABLED=false

# --- Analytics (disabled by default; privacy-by-design) ---
VITE_ANALYTICS_ENABLED=false
